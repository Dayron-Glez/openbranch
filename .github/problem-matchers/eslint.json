{
  "problemMatcher": [
    {
      "owner": "eslint-unix",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+): (.+) \\[(Error|Warning|Info)\\/.+\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 5,
          "message": 4
        }
      ]
    }
  ]
}
