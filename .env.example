# GitHub repo identity — used by the "PR →" wanted-item links.
# These are public values (NEXT_PUBLIC_*) baked into the client bundle at build time.
# Defaults to the values in lib/shared.ts (gitConfig) if not set.
NEXT_PUBLIC_REPO_OWNER=your-github-username
NEXT_PUBLIC_REPO_NAME=your-repo-name

# Supabase — playground module auth and progress tracking
# Create a project at https://supabase.com and copy these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
