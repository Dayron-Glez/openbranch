# GitHub repo identity — used by the "PR →" wanted-item links.
# These are public values (NEXT_PUBLIC_*) baked into the client bundle at build time.
# Defaults to the values in lib/shared.ts (gitConfig) if not set.
NEXT_PUBLIC_REPO_OWNER=your-github-username
NEXT_PUBLIC_REPO_NAME=your-repo-name

# Supabase — playground module auth and progress tracking.
#
# Copy this file to .env.local (gitignored) and point it at a TEST project,
# never at production: local development writes real rows, and anything it
# creates against production becomes indistinguishable from a real user's
# progress. See supabase/README.md for how the two projects are set up.
#
# Production values are not kept here or in any file — they live only in the
# Vercel project's environment variables, scoped to Production.
#
# Both are public by design: NEXT_PUBLIC_* is baked into the browser bundle,
# and the anon key is meant to be seen. Row Level Security is what protects
# the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
