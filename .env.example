# GitHub repo identity — used by the "PR →" wanted-item links.
# These are public values (NEXT_PUBLIC_*) baked into the client bundle at build time.
# Defaults to the values in lib/shared.ts (gitConfig) if not set.
NEXT_PUBLIC_REPO_OWNER=your-github-username
NEXT_PUBLIC_REPO_NAME=your-repo-name

# Revisions footer — GitHub REST API for commit history per guide.
# Create a PAT at https://github.com/settings/tokens with `public_repo` (read-only) scope.
GITHUB_TOKEN=your-github-pat

# Webhook secret for /api/revalidate (optional but recommended).
# Must match the "Secret" field in the GitHub webhook settings.
REVALIDATE_SECRET=your-webhook-secret
